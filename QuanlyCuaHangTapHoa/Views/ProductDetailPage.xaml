<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanlyCuaHangTapHoa.Views.ProductDetailPage"
             Title="Thêm sản phẩm"
             BackgroundColor="{StaticResource BgColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Entry Placeholder="Mã sản phẩm" Text="{Binding Code}" />
                    <Entry Placeholder="Tên sản phẩm" Text="{Binding Name}" />
                    <Picker Title="Nhóm hàng"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}" />
                    <Entry Placeholder="Đơn vị tính" Text="{Binding Unit}" />

                    <Entry Placeholder="Giá nhập" Keyboard="Numeric" Text="{Binding PurchasePrice}" />
                    <Entry Placeholder="Giá bán" Keyboard="Numeric" Text="{Binding SellingPrice}" />
                    <Entry Placeholder="Tồn kho" Keyboard="Numeric" Text="{Binding StockQuantity}" />

                    <Button Text="Lưu"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Button Text="Xóa"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource OutlinedButtonStyle}"
                            TextColor="{StaticResource DangerColor}"
                            BorderColor="{StaticResource DangerColor}" />

                    <Label Text="{Binding Message}"
                           TextColor="{StaticResource DangerColor}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
