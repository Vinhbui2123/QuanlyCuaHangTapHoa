<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanlyCuaHangTapHoa.Views.SalesHistoryPage"
             Title="Lịch sử bán hàng"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Làm mới"
                     Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="10">

        <!-- 🌟 HEADER -->
        <Frame Grid.Row="0"
               Style="{StaticResource CardFrameStyle}"
               Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="🧾"
                       FontSize="28"
                       VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Lịch sử hóa đơn"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="Theo dõi các giao dịch bán hàng"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- 🗓️ Bộ lọc ngày -->
        <Grid Grid.Row="1"
      ColumnDefinitions="*,*,Auto"
      ColumnSpacing="8"
      Margin="0,0,0,10">

            <!-- Từ ngày -->
            <Frame Grid.Column="0"
           Style="{StaticResource CardFrameStyle}"
           Padding="8"
           Margin="0"
           HasShadow="False">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Từ ngày"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondaryColor}" />
                    <DatePicker Date="{Binding FromDate}"
                        FontSize="13"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextPrimaryColor}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Đến ngày -->
            <Frame Grid.Column="1"
           Style="{StaticResource CardFrameStyle}"
           Padding="8"
           Margin="0"
           HasShadow="False">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Đến ngày"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondaryColor}" />
                    <DatePicker Date="{Binding ToDate}"
                        FontSize="13"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextPrimaryColor}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Nút lọc -->
            <Button Grid.Column="2"
            Text="Lọc"
            VerticalOptions="Center"
            HeightRequest="48"
            WidthRequest="90"
            Command="{Binding LoadCommand}"
            Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>


        <!-- 📋 Danh sách hóa đơn -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Sales}"
                        SelectionMode="Single"
                        >

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrameStyle}"
                           Margin="10,6,10,6">
                        <!-- BẮT TAP ĐỂ SỬA DANH MỤC -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                              Command="{Binding BindingContext.OpenDetailCommand,
                              Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                              CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">

                            <!-- Mã hóa đơn -->
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Code}"
                                   FontAttributes="Bold"
                                   FontSize="16" />

                            <!-- Ngày + số tiền -->
                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondaryColor}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Ngày: " />
                                        <Span Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                                        <Span Text="  |  Thanh toán: " />
                                        <Span Text="{Binding FinalAmount, StringFormat='{0:n0} đ'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Phương thức thanh toán -->
                            <Label Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Text="{Binding PaymentMethod}"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="{Binding Message}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource TextSecondaryColor}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- 💰 Tổng doanh thu -->
        <Label Grid.Row="3"
               HorizontalOptions="End"
               FontAttributes="Bold">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Tổng doanh thu: " />
                    <Span Text="{Binding TotalRevenue, StringFormat='{0:n0} đ'}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

    </Grid>
</ContentPage>
