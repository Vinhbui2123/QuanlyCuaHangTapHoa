<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanlyCuaHangTapHoa.Views.CategoryListPage"
             Title="Danh mục">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Thêm"
                     Command="{Binding GoToAddCommand}" />
        <ToolbarItem Text="Làm mới"
                     Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Categories}"
                    SelectionMode="Single"
                    SelectionChanged="CollectionView_SelectionChanged"
                    Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="0,5" HasShadow="True" CornerRadius="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name}"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding IsActive, StringFormat='Hoạt động: {0}'}"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.EmptyView>
            <Label Text="Chưa có danh mục nào."
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
