<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanlyCuaHangTapHoa.ViewModels"
             x:Class="QuanlyCuaHangTapHoa.Views.LoginPage"
             Title="Đăng nhập"
             BackgroundColor="{StaticResource BgColor}">

    <Grid>
        <!-- Có thể thêm gradient nhẹ bằng BoxView + Brush nếu thích -->

        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="CenterAndExpand"
            WidthRequest="360">

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Quản lý tạp hóa"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Label Text="Đăng nhập hệ thống"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondaryColor}"
                           HorizontalOptions="Center" />

                    <Entry Placeholder="Tên đăng nhập"
                           Text="{Binding Username}" />

                    <Entry Placeholder="Mật khẩu"
                           IsPassword="True"
                           Text="{Binding Password}" />

                    <Button Text="Đăng nhập"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Button Text="Đăng ký tài khoản mới"
                            Command="{Binding GoToRegisterCommand}"
                            Style="{StaticResource OutlinedButtonStyle}" />

                    <Label Text="{Binding Message}"
                           TextColor="{StaticResource DangerColor}"
                           FontSize="12"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
