<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanlyCuaHangTapHoa.Views.PosPage"
             Title="Bán hàng"
             BackgroundColor="{StaticResource BgColor}">

    <!-- Đổi thành 4 hàng: Header, Thanh tìm, Giỏ hàng, Thanh toán -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10">

        <!-- 🌟 HEADER -->
        <Frame Grid.Row="0"
               CornerRadius="18"
               HasShadow="True"
               Padding="14"
               Margin="0,0,0,10"
               BackgroundColor="#242424">
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="🛒"
                       FontSize="28"
                       VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Bán hàng tại quầy"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="Nhập mã hoặc tên để thêm sản phẩm vào giỏ"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Thanh tìm/ quét -->
        <Frame Grid.Row="1"
               Style="{StaticResource CardFrameStyle}"
               Margin="0,0,0,10">
            <HorizontalStackLayout Spacing="8">
                <Entry Placeholder="Nhập mã hoặc tên sản phẩm..."
                       HorizontalOptions="FillAndExpand"
                       Text="{Binding SearchCodeOrName}" />
                <Button Text="Thêm"
                        Command="{Binding AddProductCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="40"
                        WidthRequest="90" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Giỏ hàng -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding CartItems}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrameStyle}"
                           Margin="10,6,10,6">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Product.Name}"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondaryColor}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="SL: " />
                                        <Span Text="{Binding Quantity}" />
                                        <Span Text="  |  Giá: " />
                                        <Span Text="{Binding UnitPrice , StringFormat='{0:n0} đ'}" />
                                        <Span Text="  |  Thành tiền: " />
                                        <Span Text="{Binding TotalPrice, StringFormat='{0:n0} đ'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Nút +/-/x đẹp hơn -->
                            <HorizontalStackLayout Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="1"
                       Spacing="6"
                       VerticalOptions="Center">

                                <!-- Nút giảm -->
                                <Button Text="-"
            WidthRequest="32"
            HeightRequest="32"
            CornerRadius="16"
            FontAttributes="Bold"
            FontSize="18"
            BackgroundColor="#424242"
            TextColor="White"
            Padding="0"
            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                              Path=BindingContext.DecreaseQuantityCommand}"
            CommandParameter="{Binding .}" />

                                <!-- Nút tăng -->
                                <Button Text="+"
            WidthRequest="32"
            HeightRequest="32"
            CornerRadius="16"
            FontAttributes="Bold"
            FontSize="18"
            BackgroundColor="#673AB7"
            TextColor="White"
            Padding="0"
            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                              Path=BindingContext.IncreaseQuantityCommand}"
            CommandParameter="{Binding .}" />

                                <!-- Nút xóa -->
                                <Button Text="x"
            WidthRequest="32"
            HeightRequest="32"
            CornerRadius="16"
            FontAttributes="Bold"
            FontSize="18"
            BackgroundColor="{StaticResource DangerColor}"
            TextColor="White"
            Padding="0"
            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                              Path=BindingContext.RemoveItemCommand}"
            CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>


                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Chưa có sản phẩm nào trong giỏ."
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Panel thanh toán -->
        <Frame Grid.Row="3"
               Style="{StaticResource CardFrameStyle}"
               Margin="0,10,0,0">
            <VerticalStackLayout Spacing="6">

                <Label FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Tổng tiền: " />
                            <Span Text="{Binding TotalAmount, StringFormat='{0:n0} đ'}" />
                            <Span Text="  |  Giảm giá: " />
                            <Span Text="{Binding TotalDiscount}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Cần thanh toán: " />
                            <Span Text="{Binding FinalAmount, StringFormat='{0:n0} đ'}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <HorizontalStackLayout Spacing="8">
                    <Label Text="Khách đưa:" VerticalOptions="Center" />
                    <Entry WidthRequest="120"
                           Keyboard="Numeric"
                           Text="{Binding ReceivedAmount}" />
                    <Label Text="Tiền thừa:" VerticalOptions="Center" />
                    <Label Text="{Binding ChangeAmount}"
                           VerticalOptions="Center"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>

                <Button Text="THANH TOÁN"
                        Command="{Binding CheckoutCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Label Text="{Binding Message}"
                       TextColor="{StaticResource DangerColor}"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
