<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanlyCuaHangTapHoa.ViewModels"
             x:Class="QuanlyCuaHangTapHoa.Views.ProductListPage"
             x:Name="ProductListPageRoot"
             Title="Sản phẩm"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Thêm"
                     Priority="0"
                     Order="Primary"
                     Command="{Binding GoToAddProductCommand}" />
        <!-- NÚT LÀM MỚI -->
        <ToolbarItem Text="Làm mới"
                     Priority="1"
                     Order="Primary"
                     Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- Nhãn trạng thái tồn kho -->
        <Style x:Key="StockStatusLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="Lime" />
            <Setter Property="Text" Value="Còn hàng" />

            <Style.Triggers>
                <!-- Sắp hết -->
                <DataTrigger TargetType="Label"
                         Binding="{Binding Status}"
                         Value="LowStock">
                    <Setter Property="TextColor" Value="Orange" />
                    <Setter Property="Text" Value="Sắp hết" />
                </DataTrigger>

                <!-- Hết hàng -->
                <DataTrigger TargetType="Label"
                         Binding="{Binding Status}"
                         Value="OutOfStock">
                    <Setter Property="TextColor" Value="Red" />
                    <Setter Property="Text" Value="Hết hàng" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Viền/ nền của Frame theo trạng thái tồn -->
        <Style x:Key="ProductFrameStyle" TargetType="Frame">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HasShadow" Value="True" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="BorderColor" Value="#444" />

            <Style.Triggers>
                <DataTrigger TargetType="Frame"
                         Binding="{Binding Status}"
                         Value="LowStock">
                    <Setter Property="BorderColor" Value="Orange" />
                </DataTrigger>

                <DataTrigger TargetType="Frame"
                         Binding="{Binding Status}"
                         Value="OutOfStock">
                    <Setter Property="BorderColor" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>


    <Grid RowDefinitions="Auto,Auto,*" Padding="10">

        <!-- 🌟 HEADER -->
        <Frame Grid.Row="0"
           CornerRadius="18"
           HasShadow="True"
           Padding="14"
           Margin="0,0,0,10"
           BackgroundColor="#242424">
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="📦"
                   FontSize="28"
                   VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Danh sách sản phẩm"
                       FontSize="18"
                       FontAttributes="Bold" />
                    <Label Text="Quản lý tồn kho giá bán"
                       FontSize="13"
                       TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- 🔍 Thanh tìm kiếm -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Entry Placeholder="Tìm theo tên hoặc mã..."
               HorizontalOptions="FillAndExpand"
               Text="{Binding SearchText}"
               Completed="SearchEntry_Completed" />

            <Button Text="Tìm"
                Command="{Binding SearchCommand}" />
        </HorizontalStackLayout>

        <!-- 📋 Danh sách sản phẩm -->
        <CollectionView Grid.Row="2"
                    ItemsSource="{Binding Products}"
                    SelectionMode="Single"
                    >

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                               ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrameStyle}"
                       Margin="10,6,10,6">
                        <!-- Bắt tap trên cả item -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                    Command="{Binding BindingContext.GoToEditProductCommand,
                                      Source={x:Reference ProductListPageRoot}}"
                    CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>


                        <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                            <!-- Tên sản phẩm -->
                            <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="16" />

                            <!-- Mã, giá, tồn -->
                            <Label Grid.Row="1"
                               Grid.Column="0"
                               FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Mã: " />
                                        <Span Text="{Binding Code}" />
                                        <Span Text="  |  Giá bán: " />
                                        <Span Text="{Binding SellingPrice, StringFormat='{0:n0} đ'}" />
                                        <Span Text="  |  Tồn: " />
                                        <Span Text="{Binding StockQuantity}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Badge trạng thái -->
                            <Frame Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="1"
                               Padding="8,3"
                               CornerRadius="12"
                               HasShadow="False"
                               BackgroundColor="#262626"
                               VerticalOptions="Center"
                               Margin="0,0,4,0">
                                <Label Style="{StaticResource StockStatusLabelStyle}" />
                            </Frame>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Không có sản phẩm."
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</ContentPage>
